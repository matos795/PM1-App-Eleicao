<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:text="@string/menu_entrevistador_titulo"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center" />

        <Button
            android:id="@+id/btnPesquisaCompleta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/menu_completa"
            android:enabled="false" />

        <Button
            android:id="@+id/btnPesquisaEspontanea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/menu_espontanea"
            android:enabled="false" />

        <Button
            android:id="@+id/btnPesquisaEstimulada"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/menu_estimulada"
            android:enabled="false" />

        <Button
            android:id="@+id/btnPesquisaProblemas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/menu_problemas"
            android:enabled="false" />

        <Button
            android:id="@+id/btnSairConta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/menu_sair" />

    </LinearLayout>

</ScrollView>