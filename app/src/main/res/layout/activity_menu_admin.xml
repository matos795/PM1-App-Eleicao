<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:text="@string/menu_admin_titulo"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center" />

        <Button
            android:id="@+id/btnEntrevistados"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/menu_entrevistados"
            android:enabled="true" />

        <Button
            android:id="@+id/btnResultados"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/menu_resultados"
            android:enabled="true" />

        <Button
            android:id="@+id/btnLimparDados"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/menu_limpar"
            android:enabled="true" />

        <Button
            android:id="@+id/btnSairConta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/menu_sair" />

    </LinearLayout>

</ScrollView>